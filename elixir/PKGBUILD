pkgname="carbonio-elixir"
pkgver="1.19.0"
pkgrel="1"
pkgdesc="A functional meta-programming aware language built on top of the Erlang VM"
url="https://www.zextras.com/"
maintainer="Zextras <packages@zextras.com>"
license=("Apache-2.0")
section="utils"
priority="optional"
arch=('x86_64')
depends=("carbonio-erlang")
source=(
  "https://github.com/elixir-lang/elixir/archive/v${pkgver}.tar.gz"
)
sha256sums=('99a684045b49f9c5005a1aa8278e1bac8c3769e0a5a13c05ef80b69113029234')

build() {
  export PATH="/opt/zextras/common/bin/:$PATH"

  cd "${srcdir}/elixir-${pkgver}"
  make -j8
}

package() {
  export PATH="/opt/zextras/common/bin/:$PATH"

  cd "${srcdir}/elixir-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
  rm -rf "${pkgdir}"/usr/share/man
}
