pkgname="carbonio-erlang"
pkgver="26.2.5.2" # renovate: datasource=github-tags depName=erlang/otp
pkgrel="2"
pkgdesc="General-purpose concurrent functional programming language (headless version)"
arch=('x86_64')
url="https://erlang.org/"
maintainer="Zextras <packages@zextras.com>"
license=("Apache-2.0")
section="utils"
priority="optional"
depends__apt=(
  "carbonio-openssl"
  "libncursesw6"
)
makedepends__apt=(
  "carbonio-openssl"
  "git"
  "libncurses-dev"
  "libxslt1-dev"
  "lksctp-tools"
  "unixodbc"
  "util-linux-locales"
)
depends__yum=(
  "carbonio-openssl"
  "ncurses"
)
makedepends__yum=(
  "carbonio-openssl"
  "git"
  "libxslt-devel"
  "lksctp-tools"
  "ncurses-devel"
  "unixODBC"
)
provides__yum=(
  "/usr/bin/escript"
)
source=(
  "epmd.conf"
  "epmd.service"
  "epmd.socket"
  "https://github.com/erlang/otp/archive/OTP-${pkgver}.tar.gz"
)
sha256sums=(
  '78ce5e67b21758c767d727e56b20502f75dc4385ff9b6c6db312d8e8506f2df2'
  '44d00882c45ea5df8134714489e9836a332452601ac70f48daa121e63bd2cbed'
  '998a759e4cea4527f9d9b241bf9f32527d7378d63ea40afa38443c6c3ceaea34'
  '8e537e2d984770796cc7f0c7c079a9e5fbc67b8c368e0dcd9aa2ceaeb2844da2'
)

build() {
  cd "${srcdir}/otp-OTP-${pkgver}"

  ./otp_build autoconf

  ./configure \
    --enable-builtin-zlib \
    --enable-smp-support \
    --prefix=/opt/zextras/common \
    --with-odbc \
    --with-ssl=/opt/zextras/common
  make release
}

package() {
  cd "${srcdir}"

  make -C otp-OTP-${pkgver} DESTDIR="${pkgdir}" install

  # services and configuration
  install -Dm644 epmd.service "${pkgdir}/lib/systemd/system/epmd.service"
  install -Dm644 epmd.socket "${pkgdir}/lib/systemd/system/epmd.socket"
  install -Dm644 epmd.conf "${pkgdir}/etc/conf.d/epmd"

  # remove files that are included in the erlang-unixodbc package
  rm -rf "${pkgdir}/opt/zextras/common/erlang/"{lib/odbc*,man/man3/odbc.3}
}
