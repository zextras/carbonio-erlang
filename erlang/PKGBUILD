build() {
  cd "${srcdir}/otp-OTP-${pkgver}"
  ./otp_build autoconf

  if [ -n "${CROSS_COMPILE}" ]; then
    # Step 1: Build native bootstrap in-tree following OTP's documented
    # cross-compilation workflow. We use --enable-bootstrap-only to get
    # erlc/escript for BEAM compilation, then cross-configure in the same tree.
    # Save/restore cross-compile env for the native phase
    _save_CC="${CC}"
    _save_CXX="${CXX}"
    _save_PKG_CONFIG_LIBDIR="${PKG_CONFIG_LIBDIR}"
    _save_PKG_CONFIG_PATH="${PKG_CONFIG_PATH}"
    unset CC CXX
    unset PKG_CONFIG_LIBDIR PKG_CONFIG_PATH

    CC=gcc CXX=g++ ./configure \
      --enable-bootstrap-only \
      --enable-builtin-zlib \
      --enable-smp-support \
      --without-termcap
    make -j"$(nproc)"

    # Bootstrap binaries are in bin/ — add to PATH
    export PATH="${PWD}/bin:${PATH}"

    # Step 2: Cross-compile for target architecture
    export CC="${_save_CC}"
    export CXX="${_save_CXX}"
    export PKG_CONFIG_LIBDIR="${_save_PKG_CONFIG_LIBDIR}"
    if [ -n "${_save_PKG_CONFIG_PATH}" ]; then
      export PKG_CONFIG_PATH="${_save_PKG_CONFIG_PATH}"
    else
      unset PKG_CONFIG_PATH
    fi

    if [ -z "${YAP_CROSS_SYSROOT}" ] || [ ! -d "${YAP_CROSS_SYSROOT}" ]; then
      echo "YAP_CROSS_SYSROOT must be set to an existing directory for cross builds"
      return 1
    fi

    # Without erl_xcomp_sysroot, OTP drops crypto, ssh and ssl outright when
    # cross compiling and writes lib/<app>/SKIP saying so — whatever
    # --with-ssl says (lib/crypto/configure, erl_xcomp_without_sysroot).
    # With it set, every SSL path is probed as $erl_xcomp_sysroot$dir and the
    # runtime library path is derived by stripping the sysroot back off, so
    # --with-ssl takes the on-target prefix, not the sysroot-qualified one.
    export erl_xcomp_sysroot="${YAP_CROSS_SYSROOT}"

    # --with-ssl=PATH alone is not enough here: with cross_compiling=yes,
    # lib/crypto/configure derives the runtime rpath by stripping
    # $erl_xcomp_sysroot off SSL_LIBDIR, but SSL_LIBDIR was probed without
    # the sysroot prefix, so the strip yields an empty string and crypto.so
    # ends up with a corrupted RUNPATH missing /opt/zextras/common/lib (the
    # loader then falls back to the distro's OpenSSL 3.0.2 and crypto.so
    # fails with "OPENSSL_3.4.0 not found"). --with-ssl-rpath sets the rpath
    # from the given dirs directly and errors out at configure time if the
    # resulting link fails, instead of shipping a silently broken .so.
    ./configure \
      --enable-builtin-zlib \
      --enable-smp-support \
      --without-termcap \
      --prefix=/opt/zextras/common \
      --with-odbc \
      --host="${CROSS_COMPILE_HOST}" \
      --build="$(./erts/autoconf/config.guess 2>/dev/null || uname -m)" \
      --with-ssl=/opt/zextras/common \
      --with-ssl-rpath=/opt/zextras/common/lib

    make -j"$(nproc)" release
  else
    ./configure \
      --enable-builtin-zlib \
      --enable-smp-support \
      --prefix=/opt/zextras/common \
      --with-odbc \
      --with-ssl=/opt/zextras/common
    make -j"$(nproc)" release
  fi
}

package() {
  cd "${srcdir}"

  make -C otp-OTP-${pkgver} DESTDIR="${pkgdir}" install

  # configure omits crypto, ssh and ssl entirely when it cannot locate
  # OpenSSL, and says so only in a log line nobody reads. The result is an
  # Erlang that cannot run rebar3 or serve TLS, which is worse than a failed
  # build — the aarch64 package shipped that way. Fail loudly instead.
  for _app in crypto ssh ssl; do
    if [ -z "$(find "${pkgdir}/opt/zextras/common/lib/erlang/lib" \
      -maxdepth 1 -type d -name "${_app}-*" -print -quit)" ]; then
      echo "OTP application ${_app} was not built: configure did not find OpenSSL"
      return 1
    fi
  done

  # The RPATH bug fixed by --with-ssl-rpath above can silently regress if
  # configure's cross-compile branch changes again — verify the shipped
  # crypto NIF really carries /opt/zextras/common/lib in its RUNPATH so the
  # loader picks carbonio-openssl instead of the distro's libcrypto.
  _readelf="readelf"
  if [ -n "${CROSS_COMPILE}" ] && command -v "${CROSS_COMPILE}readelf" >/dev/null 2>&1; then
    _readelf="${CROSS_COMPILE}readelf"
  fi
  if command -v "${_readelf}" >/dev/null 2>&1; then
    _crypto_so="$(find "${pkgdir}/opt/zextras/common/lib/erlang/lib" \
      -path '*/crypto-*/priv/lib/crypto.so' -print -quit)"
    if [ -z "${_crypto_so}" ] || ! "${_readelf}" -d "${_crypto_so}" \
      | grep -E 'R(UN)?PATH' | grep -q '/opt/zextras/common/lib'; then
      echo "${_crypto_so:-crypto.so} is missing /opt/zextras/common/lib in its RPATH/RUNPATH: the build linked against the wrong OpenSSL search path"
      return 1
    fi
  fi

  # services and configuration
  install -Dm644 epmd.service "${pkgdir}/lib/systemd/system/epmd.service"
  install -Dm644 epmd.socket "${pkgdir}/lib/systemd/system/epmd.socket"
  install -Dm644 epmd.conf "${pkgdir}/etc/conf.d/epmd"

  # remove files that are included in the erlang-unixodbc package
  rm -rf "${pkgdir}/opt/zextras/common/erlang/"{lib/odbc*,man/man3/odbc.3}
}
