pkgname="carbonio-erlang"
pkgver="27.3.4.8" # renovate: datasource=github-tags depName=erlang/otp
pkgrel="1"
pkgdesc="General-purpose concurrent functional programming language (headless version)"
arch=('x86_64')
url="https://erlang.org/"
maintainer="Zextras <packages@zextras.com>"
license=("Apache-2.0")
section="utils"
priority="optional"
depends__apt=(
  "carbonio-openssl"
  "libncursesw6"
)
makedepends__apt=(
  "carbonio-openssl"
  "git"
  "libncurses-dev"
  "libxslt1-dev"
  "lksctp-tools"
  "unixodbc"
  "util-linux-locales"
)
depends__yum=(
  "carbonio-openssl"
  "ncurses"
)
makedepends__yum=(
  "carbonio-openssl"
  "git"
  "libxslt-devel"
  "lksctp-tools"
  "ncurses-devel"
  "unixODBC"
)
provides__yum=(
  "/usr/bin/escript"
)
source=(
  "epmd.conf"
  "epmd.service"
  "epmd.socket"
  "https://github.com/erlang/otp/archive/OTP-${pkgver}.tar.gz"
)
sha256sums=(
  'df7d8b3378eaa522d4e1354869d5202fe609ecda3f60ba566934f6d1fe4e4d67'
  'eb3c7093d548a4ebfa5a2af5f204d836b77668e4c3419b110e6fe10941c4ae90'
  '1d69277d5b03824808532206edf68f9fc30e09be0542be8e01087d740d0cf3d6'
  '987fafbfcd30f0c0865481b2266abcf3f86ef124aee88fbb809c775a8c799609'
)

build() {
  cd "${srcdir}/otp-OTP-${pkgver}"

  ./otp_build autoconf

  ./configure \
    --enable-builtin-zlib \
    --enable-smp-support \
    --prefix=/opt/zextras/common \
    --with-odbc \
    --with-ssl=/opt/zextras/common
  make release
}

package() {
  cd "${srcdir}"

  make -C otp-OTP-${pkgver} DESTDIR="${pkgdir}" install

  # services and configuration
  install -Dm644 epmd.service "${pkgdir}/lib/systemd/system/epmd.service"
  install -Dm644 epmd.socket "${pkgdir}/lib/systemd/system/epmd.socket"
  install -Dm644 epmd.conf "${pkgdir}/etc/conf.d/epmd"

  # remove files that are included in the erlang-unixodbc package
  rm -rf "${pkgdir}/opt/zextras/common/erlang/"{lib/odbc*,man/man3/odbc.3}
}
